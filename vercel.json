{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npm run check",
  "outputDirectory": "vercel-static",
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**",
      "maxDuration": 60
    }
  },
  "routes": [{ "src": "/(.*)", "dest": "/api/index.js" }]
}
